        </mxCell>

        <mxCell id="bg-int" value="Внутренние ИС «Diamond Universe»" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;fontSize=13;fontColor=#666666;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="740" height="710" as="geometry" />
        </mxCell>
        <mxCell id="bg-ext" value="Внешние системы и сервисы" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;fontSize=13;fontColor=#666666;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="820" y="100" width="470" height="710" as="geometry" />
        </mxCell>

        <mxCell id="almazy" value="&lt;b style=&quot;font-size:14px&quot;&gt;&lt;font color=&quot;#1a56a8&quot;&gt;⚑&lt;/font&gt; ИС «Алмазы»&lt;/b&gt;&lt;br&gt;&lt;br&gt;• планирование работ&lt;br&gt;• отбор алмазов для онлайн-аукциона&lt;br&gt;• присвоение идентификаторов, ведомости&lt;br&gt;• план и статус подготовки и проведения аукциона &lt;font color=&quot;#237a35&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="80" y="140" width="250" height="180" as="geometry" />
        </mxCell>
        <mxCell id="logistics" value="&lt;b style=&quot;font-size:14px&quot;&gt;&lt;font color=&quot;#1a56a8&quot;&gt;⚑&lt;/font&gt; ИС «Логистика»&lt;/b&gt;&lt;br&gt;&lt;br&gt;• перевозка камней (страна / за границу)&lt;br&gt;• оформление экспортных документов&lt;br&gt;• маршрут офис → лаборатория → офис&lt;br&gt;• отправка победителям" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="80" y="375" width="250" height="160" as="geometry" />
        </mxCell>
        <mxCell id="accounting" value="&lt;b style=&quot;font-size:14px&quot;&gt;&lt;font color=&quot;#1a56a8&quot;&gt;⚑&lt;/font&gt; ИС «Бухгалтерия»&lt;/b&gt;&lt;br&gt;&lt;br&gt;• контракты, акты, оплаты&lt;br&gt;• оплата перевозчиков&lt;br&gt;• актирование и оплата лаборатории" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="80" y="630" width="250" height="140" as="geometry" />
        </mxCell>
        <mxCell id="auction" value="&lt;b style=&quot;font-size:14px&quot;&gt;&lt;font color=&quot;#1a56a8&quot;&gt;⚑&lt;/font&gt; ИС «Аукцион»&lt;/b&gt;&lt;br&gt;&lt;br&gt;• проведение аукциона&lt;br&gt;• онлайн-режим: приём ставок в системе &lt;font color=&quot;#237a35&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• определение победителей торгов" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="430" y="140" width="310" height="150" as="geometry" />
        </mxCell>
        <mxCell id="publish" value="&lt;b style=&quot;font-size:14px&quot;&gt;&lt;font color=&quot;#237a35&quot;&gt;✚&lt;/font&gt; Сервис публикации данных&lt;/b&gt;&lt;br&gt;(on-prem; выделен из ИС «Аукцион» — архитектурное решение)&lt;br&gt;&lt;br&gt;• витрина данных оцифровки для покупателей&lt;br&gt;• публикация лотов и описаний (вместо внешнего облака)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="430" y="360" width="310" height="140" as="geometry" />
