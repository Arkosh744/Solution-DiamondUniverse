        <mxCell id="excel" value="&lt;b style=&quot;font-size:14px&quot;&gt;&lt;font color=&quot;#b02318&quot;&gt;✕&lt;/font&gt; Excel-реестры&lt;/b&gt;&lt;br&gt;&lt;s&gt;вводные для аукциона по шаблонам&lt;/s&gt;&lt;br&gt;&lt;br&gt;ВЫВОДИТСЯ: функции перенесены в ИС" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;size=18;" vertex="1" parent="1">
