  <diagram id="diamond-intermediate" name="Промежуточное решение">
    <mxGraphModel dx="1400" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Диаграмма контекста — ПРОМЕЖУТОЧНОЕ решение (первый онлайн-аукцион за 2 месяца, без существенных доработок ИС)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1240" height="36" as="geometry" />
        </mxCell>

        <mxCell id="bg-int" value="Внутренние ИС «Diamond Universe»" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;fontSize=13;fontColor=#666666;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="740" height="710" as="geometry" />
        </mxCell>
        <mxCell id="bg-ext" value="Внешние системы и сервисы" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;fontSize=13;fontColor=#666666;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="820" y="100" width="470" height="710" as="geometry" />
        </mxCell>

        <mxCell id="almazy" value="&lt;b style=&quot;font-size:14px&quot;&gt;&lt;font color=&quot;#1a56a8&quot;&gt;⚑&lt;/font&gt; ИС «Алмазы»&lt;/b&gt;&lt;br&gt;&lt;br&gt;• планирование работ&lt;br&gt;• отбор алмазов для онлайн-аукциона &lt;font color=&quot;#237a35&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• присвоение идентификаторов&lt;br&gt;• подготовка ведомостей" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="80" y="140" width="250" height="165" as="geometry" />
        </mxCell>
        <mxCell id="logistics" value="&lt;b style=&quot;font-size:14px&quot;&gt;&lt;font color=&quot;#1a56a8&quot;&gt;⚑&lt;/font&gt; ИС «Логистика»&lt;/b&gt;&lt;br&gt;&lt;br&gt;• перевозка камней по стране и за границу&lt;br&gt;• оформление экспортных документов&lt;br&gt;• маршрут офис → лаборатория → офис &lt;font color=&quot;#237a35&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• отправка победителям" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="80" y="380" width="250" height="165" as="geometry" />
        </mxCell>
        <mxCell id="accounting" value="&lt;b style=&quot;font-size:14px&quot;&gt;&lt;font color=&quot;#1a56a8&quot;&gt;⚑&lt;/font&gt; ИС «Бухгалтерия»&lt;/b&gt;&lt;br&gt;&lt;br&gt;• контракты, акты, оплаты&lt;br&gt;• оплата перевозчиков&lt;br&gt;• актирование и оплата лаборатории &lt;font color=&quot;#237a35&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="80" y="640" width="250" height="150" as="geometry" />
        </mxCell>
        <mxCell id="auction" value="&lt;b style=&quot;font-size:14px&quot;&gt;&lt;font color=&quot;#1a56a8&quot;&gt;⚑&lt;/font&gt; ИС «Аукцион»&lt;/b&gt;&lt;br&gt;&lt;br&gt;• проведение аукциона&lt;br&gt;• определение победителей торгов&lt;br&gt;• публикация данных покупателям (через частное облако) &lt;font color=&quot;#237a35&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• регистрация ставок покупателей — вручную &lt;font color=&quot;#237a35&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; (допущение)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="430" y="140" width="310" height="175" as="geometry" />
        </mxCell>
        <mxCell id="excel" value="&lt;b style=&quot;font-size:14px&quot;&gt;&lt;font color=&quot;#237a35&quot;&gt;✚&lt;/font&gt; Excel-реестры&lt;/b&gt;&lt;br&gt;(временная «ИС», только промеж.)&lt;br&gt;&lt;br&gt;• вводные для аукциона по шаблонам&lt;br&gt;• ведомости лотов, описания, акты&lt;br&gt;• план/статус подготовки аукциона" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;size=18;" vertex="1" parent="1">
          <mxGeometry x="430" y="640" width="310" height="150" as="geometry" />
